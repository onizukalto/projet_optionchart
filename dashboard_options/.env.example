# Copie ce fichier en .env et remplis tes valeurs. Ne partage jamais le fichier .env.
# Attention : pas de commentaire sur la même ligne qu'une valeur (Docker le lirait comme une partie de la valeur).

FREEFLOW_API_KEY="ta_cle_freeflow_ici"

# "freeflow" = vraies données, "demo" = données inventées pour tester sans clé
MODE=freeflow

# Sous-jacent affiché au démarrage : QQQ, NDX, SPY ou SPX
SYMBOLE=QQQ

# Bougies, net drift, topologie (le snapshot, lui, arrive en continu par le flux)
REFRESH_SECONDES=60

# 13 pour le plan standard (15 appels/min), 90 pour le premium (100 appels/min)
LIMITE_APPELS_MINUTE=13

# Strikes affichés : +/- 6 % autour du prix
ZONE=0.06

# Bulles de flux d'options : prime minimale (en $) d'un sweep / block pour être récupéré
PRIME_MIN_FLUX=25000

# Flux RSS ajoutés aux news (séparés par des virgules). Décommente et laisse vide pour FreeFlow seulement.
# NEWS_RSS=

# Laisse vide en local. À remplir avant de mettre le dashboard en ligne.
DASHBOARD_USER=moi
DASHBOARD_PASSWORD=
